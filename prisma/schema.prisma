// This is your Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Property {
  id           Int      @id @default(autoincrement())
  propertyNo   String   @unique
  type         String
  title        String
  price        Int?
  address      String?
  station      String?
  floorPlan    String?
  landArea     Float?
  buildingArea Float?
  buildingAge  Int?
  description  String?
  createdAt    DateTime @default(now())
}
