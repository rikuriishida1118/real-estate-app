// This is your Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "./src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model property {
  id       Int    @id @default(autoincrement())
  title    String
  price    Int
  location String
}

model user {
  id    String @id @default(cuid())
  email String @unique
  name  String?
}
