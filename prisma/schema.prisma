// This is your Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model property {
  id       Int    @id @default(autoincrement())
  title    String
  price    Int
  location String
}

model user {
  id          Int    @id @default(autoincrement())
  name        String
  phoneNumber String
  email       String
  createdAt   DateTime @default(now())
}
